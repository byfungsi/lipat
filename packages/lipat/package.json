{
  "name": "@byfungsi/lipat",
  "version": "0.1.0",
  "description": "Agent-friendly slide authoring, independent PPTX import/export, React views and a Rust WebAssembly core",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./model": {
      "types": "./dist/model.d.ts",
      "import": "./dist/model.js"
    },
    "./core": {
      "types": "./dist/core.d.ts",
      "import": "./dist/core.js"
    },
    "./pptx": {
      "types": "./dist/pptx.d.ts",
      "import": "./dist/pptx.js"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "import": "./dist/react.js"
    },
    "./wasm": {
      "types": "./dist/wasm.d.ts",
      "import": "./dist/wasm.js"
    },
    "./lipat.wasm": "./dist/lipat.wasm",
    "./agent": {
      "types": "./dist/agent.d.ts",
      "import": "./dist/agent.js"
    },
    "./reveal": {
      "types": "./dist/reveal.d.ts",
      "import": "./dist/reveal.js"
    },
    "./render": {
      "types": "./dist/render.d.ts",
      "import": "./dist/render.js"
    }
  },
  "scripts": {
    "build": "tsup --config ../../tsup.config.ts"
  },
  "dependencies": {},
  "peerDependencies": {
    "react": "^18.3.0 || ^19.0.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/byfungsi/lipat.git",
    "directory": "packages/lipat"
  },
  "homepage": "https://byfungsi.github.io/lipat/",
  "bugs": {
    "url": "https://github.com/byfungsi/lipat/issues"
  },
  "keywords": [
    "pptx",
    "presentation",
    "slides",
    "agent",
    "wasm",
    "react",
    "headless"
  ],
  "engines": {
    "node": ">=22.12.0"
  }
}
