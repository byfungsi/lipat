{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "skipLibCheck": true,
    "verbatimModuleSyntax": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "paths": {
      "@lipat-internal/model": ["./packages/model/src/index.ts"],
      "@lipat-internal/core": ["./packages/core/src/index.ts"],
      "@lipat-internal/pptx": ["./packages/pptx/src/index.ts"],
      "@lipat-internal/wasm": ["./packages/wasm/src/index.ts"],
      "@lipat-internal/react": ["./packages/react/src/index.tsx"],
      "@byfungsi/lipat": ["./packages/lipat/src/index.ts"],
      "@byfungsi/lipat-native": ["./packages/lipat-native/src/index.ts"],
      "@byfungsi/lipat/*": ["./packages/lipat/src/*"],
      "@lipat-internal/agent": ["./packages/agent/src/index.ts"],
      "@lipat-internal/reveal": ["./packages/reveal/src/index.ts"],
      "@lipat-internal/render": ["./packages/render/src/index.ts"],
      "@lipat-internal/motion": ["./packages/motion/src/index.ts"],
      "@lipat-internal/images": ["./packages/images/src/index.ts"],
      "@lipat-internal/engine": ["./packages/engine/src/index.ts"],
      "@lipat-internal/native": ["./packages/native/src/index.ts"],
      "@lipat-internal/react-native": ["./packages/react-native/src/index.ts"],
      "@lipat-internal/browser-playback": [
        "./packages/browser-playback/src/index.ts"
      ],
      "@lipat-internal/templates": ["./packages/templates/src/index.ts"]
    },
    "types": ["node", "vitest/globals"]
  },
  "include": ["packages", "examples", "tests", "*.ts"],
  "exclude": [
    "**/dist",
    "**/node_modules",
    "**/target",
    "packages/lipat-native/native",
    "examples/native-demo/ios",
    "examples/native-demo/android"
  ]
}
