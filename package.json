{
  "name": "lipat-workspace",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "examples/*"
  ],
  "scripts": {
    "build": "npm run build:wasm && npm run build -w @byfungsi/lipat && npm run build -w @lipat/demo",
    "build:wasm": "node scripts/build-wasm.mjs",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.headless.json",
    "test": "npm run build:wasm && vitest run",
    "verify": "npm run check:boundaries && npm run typecheck && npm test && cargo test --workspace && npm run build && node scripts/check-package.mjs && npm run docs:compile",
    "check:boundaries": "node scripts/check-boundaries.mjs",
    "dev": "npm run build:wasm && npm run build -w @byfungsi/lipat && npm run dev -w @lipat/demo",
    "docs:dev": "npm run build && node scripts/generate-docs.mjs && vitepress docs --host 127.0.0.1",
    "docs:build": "npm run build && npm run docs:compile",
    "format": "prettier --write packages examples scripts tests docs *.json *.ts *.md",
    "verify:browser": "node scripts/verify-browser.mjs",
    "schemas:generate": "node scripts/generate-schemas.mjs",
    "verify:interop": "node scripts/verify-interop.mjs",
    "docs:compile": "node scripts/generate-docs.mjs && vitepress build docs",
    "docs:preview": "vitepress preview docs --host 127.0.0.1 --port 4179",
    "release:prepare": "node scripts/prepare-release.mjs",
    "verify:openxml": "node scripts/verify-openxml.mjs"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.0",
    "@types/node": "^22.19.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "esbuild": "^0.28.2",
    "fast-check": "^4.5.0",
    "jsdom": "^26.1.0",
    "motion": "^14.6.0",
    "playwright": "^1.56.0",
    "prettier": "^3.9.8",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vite": "^7.3.1",
    "vitepress": "^1.6.4",
    "vitest": "^5.0.1"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "license": "MIT",
  "overrides": {
    "esbuild": "$esbuild",
    "vitepress": {
      "vite": "^6.4.5"
    }
  }
}
